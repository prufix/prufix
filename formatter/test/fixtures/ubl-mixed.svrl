<?xml version="1.0" encoding="UTF-8"?>
<svrl:schematron-output xmlns:svrl="http://purl.oclc.org/dsdl/svrl"
                        title="EN16931 + PEPPOL merged" schemaVersion="">
  <svrl:ns-prefix-in-attribute-values prefix="cbc" uri="urn:oasis:names:specification:ubl:schema:xsd:CommonBasicComponents-2"/>
  <svrl:ns-prefix-in-attribute-values prefix="cac" uri="urn:oasis:names:specification:ubl:schema:xsd:CommonAggregateComponents-2"/>
  <svrl:ns-prefix-in-attribute-values prefix="ubl" uri="urn:oasis:names:specification:ubl:schema:xsd:Invoice-2"/>
  <!-- 1: unknown rule, id only inside the text, wildcard-prefix location -->
  <svrl:failed-assert flag="fatal"
      test="false()"
      location="/*:Invoice[namespace-uri()='urn:oasis:names:specification:ubl:schema:xsd:Invoice-2'][1]/*:IssueDate[1]">
    <svrl:text>[XR-DE-27]-The invoice must contain a Leitweg-ID in "Buyer reference" (BT-10). This rule is intentionally not in the dictionary.</svrl:text>
  </svrl:failed-assert>
  <!-- 2: successful-report = warning per contract §4.3, unknown rule -->
  <svrl:successful-report flag="fatal" id="UBL-SR-49"
      test="..."
      location="/ubl:Invoice[1]">
    <svrl:text>Use of extension components is not recommended. Receivers may ignore them.</svrl:text>
  </svrl:successful-report>
  <!-- 3: failed-assert with flag=warning, unknown rule -->
  <svrl:failed-assert flag="warning" id="PEPPOL-COMMON-R042"
      test="..."
      location="/ubl:Invoice[1]/cac:AccountingSupplierParty[1]">
    <svrl:text>Norwegian organization number in ISO6523 should be valid.</svrl:text>
  </svrl:failed-assert>
  <!-- 4: no id, no usable text id; id only via @see -> dictionary hit R010 -->
  <svrl:failed-assert flag="fatal"
      see="https://docs.peppol.eu/poacc/billing/3.0/rules/PEPPOL-EN16931-R010"
      test="..."
      location="/ubl:Invoice[1]/cac:AccountingCustomerParty[1]/cac:Party[1]">
    <svrl:text>Buyer electronic address MUST be provided</svrl:text>
  </svrl:failed-assert>
</svrl:schematron-output>
